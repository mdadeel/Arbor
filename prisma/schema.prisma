// Arbor v1 — Minimal Schema (User + Project + Analysis)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum ProjectStatus {
  active
  archived
}

enum AnalysisStatus {
  queued
  cloning
  analyzing
  completed
  failed
}

enum EnvVariableStatus {
  set
  missing
  different
  unknown
}

enum EnvVariableCategory {
  database
  api_key
  auth
  config
  storage
  other
}

enum EnvironmentType {
  development
  staging
  production
  custom
}

enum ApiType {
  rest
  graphql
}

enum SpecFormat {
  openapi3
  openapi2
  graphql_schema
  manual
}

enum DocCategory {
  guide
  architecture
  api
  runbook
  adr
  onboarding
  general
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer
}

enum InvitationStatus {
  pending
  accepted
  revoked
}

enum ProjectGroupRole {
  frontend
  backend
  service
  shared_lib
}

enum SystemAnalysisStatus {
  queued
  analyzing
  completed
  failed
}

enum PullRequestAnalysisStatus {
  queued
  analyzing
  completed
  failed
  closed
}

enum FindingTriageStatus {
  open
  accepted_risk
  false_positive
  resolved
}

enum ScanCadence {
  daily
  weekly
}

enum NotificationKind {
  critical_finding
  finding_alert
  score_regression
  scan_completed
}

enum WebhookDeliveryStatus {
  received
  processing
  queued
  ignored
  failed
}

enum PatchSuggestionStatus {
  proposed
  accepted
  dismissed
}

// ─────────────────────────────────────────────
// IDENTITY CONTEXT
// ─────────────────────────────────────────────

model User {
  id             String  @id @default(cuid())
  email          String  @unique
  name           String
  avatarUrl      String?
  githubId       Int     @unique
  githubUsername String

  // GitHub OAuth token (encrypted at application layer)
  githubAccessToken String?
  tokenExpiresAt    DateTime?
  tokenScope        String?

  projects       Project[]
  memberships    WorkspaceMember[]
  auditLogs      AuditLog[]
  githubAccounts GitHubAccount[]
  projectGroups  ProjectGroup[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  findingTriageEvents FindingTriageEvent[]
  patchSuggestions PatchSuggestion[]

  // AI Integration (BYOK)
  openaiApiKey    String?
  anthropicApiKey String?
  aiModel         String? @default("gpt-4o")

  // Access Controls & Plans (Phase 9 Admin)
  role            String   @default("user") // "user" | "admin" | "moderator"
  status          String   @default("active") // "active" | "suspended"
  plan            String   @default("free") // "free" | "pro" | "teams" | "enterprise" | "lifetime"
  benefits        Json?    // { perks: string[], customNotes?: string, grantedAt?: string, grantedBy?: string }
  permissions     Json?    // { bypassRateLimit?: boolean, canAnalyzePrivate?: boolean, unlimitedProjects?: boolean }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PROJECT CONTEXT
// ─────────────────────────────────────────────

model Project {
  id              String  @id @default(cuid())
  userId          String
  workspaceId     String?
  githubAccountId String?
  name            String
  slug            String
  description     String?

  // Repository info
  repoFullName  String // "owner/repo"
  repoUrl       String
  defaultBranch String  @default("main")
  repoPrivate   Boolean @default(false)

  // Denormalized from latest analysis (for dashboard performance)
  detectedStack Json? // { framework, language, database, ... }
  latestScores  Json? // { overall, architecture, techDebt, ... }

  // Status
  status           ProjectStatus @default(active)
  lastAnalyzedAt   DateTime?
  healthData       Json?         // Cached repository health metrics & score
  lastHealthSyncAt DateTime?

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  githubAccount GitHubAccount? @relation(fields: [githubAccountId], references: [id], onDelete: SetNull)
  analyses      Analysis[]
  environments  Environment[]
  apiSpecs      ApiSpec[]
  documents     Document[]
  auditLogs     AuditLog[]
  groupMembers  ProjectGroupMember[]
  pullRequestAnalyses PullRequestAnalysis[]
  policyPackSettings PolicyPackSetting[]
  findingTriages FindingTriage[]
  scanSchedule ScanSchedule?
  notifications Notification[]
  reportShareLinks ReportShareLink[]
  patchSuggestions PatchSuggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@unique([userId, repoFullName])
  @@index([userId, status])
  @@index([workspaceId])
  @@index([githubAccountId])
}

// ─────────────────────────────────────────────
// GITHUB MULTI-ACCOUNT INTEGRATION
// ─────────────────────────────────────────────

model GitHubAccount {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username    String
  accountName String?   // e.g. "Personal", "Work", "Acme Org"
  accessToken String    // Encrypted AES-256-GCM
  tokenType   String    @default("oauth") // "oauth" | "pat"
  avatarUrl   String?
  scope       String?
  isDefault   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projects    Project[]

  @@unique([userId, username])
  @@index([userId])
}

// ─────────────────────────────────────────────
// ANALYSIS CONTEXT
// ─────────────────────────────────────────────

model Analysis {
  id        String @id @default(cuid())
  projectId String

  // Status
  status AnalysisStatus @default(queued)
  analysisVersion Int @default(1) // Bump when score/finding semantics change; trends only compare matching versions.

  // Git info (populated after clone)
  commitSha          String?
  requestedCommitSha String?
  commitMessage      String?
  branch             String

  // Scores (0-100, null until completed)
  overallScore       Int?
  architectureScore  Int?
  techDebtScore      Int?
  performanceScore   Int?
  documentationScore Int?
  securityScore      Int?
  designSystemScore  Int?

  // Detailed results (JSON, null until completed)
  techStack       Json? // DetectedTechStack
  structure       Json? // ProjectStructure
  findings        Json? // Finding[]
  dependencyGraph Json? // { nodes: [], edges: [] }
  metrics         Json? // { files, loc, components, hooks, routes, ... }
  designSystem    Json? // DesignSystemAudit
  dependencyInventory Json? // Normalized direct/transitive package inventory
  dependencyAdvisories Json? // Bounded advisory lookup with source/freshness metadata
  sbom Json? // CycloneDX 1.5 JSON export
  policySnapshot Json? // Versioned effective policies applied to this immutable run

  // Timing
  durationMs   Int?
  errorMessage String?

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pullRequestAnalysis PullRequestAnalysis? @relation("PullRequestAnalysisToAnalysis")
  reportShareLinks ReportShareLink[]
  notifications Notification[]
  patchSuggestions PatchSuggestion[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([projectId, createdAt(sort: Desc)])
  @@index([projectId, status])
  @@index([status])
}

// ─────────────────────────────────────────────
// ENVIRONMENT MANAGER (Phase 4)
// ─────────────────────────────────────────────

model Environment {
  id        String          @id @default(cuid())
  projectId String
  name      String          // "development", "staging", "production"
  type      EnvironmentType @default(development)
  url       String?

  variables EnvVariable[]

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model EnvVariable {
  id            String             @id @default(cuid())
  environmentId String
  key           String
  status        EnvVariableStatus  @default(unknown)
  required      Boolean            @default(true)
  category      EnvVariableCategory @default(other)
  description   String?

  environment Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([environmentId, key])
  @@index([environmentId])
}

// ─────────────────────────────────────────────
// API EXPLORER (Phase 4)
// ─────────────────────────────────────────────

model ApiSpec {
  id        String     @id @default(cuid())
  projectId String
  name      String
  version   String
  type      ApiType    @default(rest)

  specFormat  SpecFormat @default(openapi3)
  rawSpec     String     @db.Text

  parsedEndpoints Json?
  parsedSchemas   Json?
  baseUrls        Json?
  endpointCount   Int     @default(0)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// ─────────────────────────────────────────────
// DOCUMENTATION HUB (Phase 5)
// ─────────────────────────────────────────────

model Document {
  id          String      @id @default(cuid())
  projectId   String
  title       String
  slug        String
  content     String      @db.Text
  category    DocCategory @default(general)

  parentId    String?
  sortOrder   Int         @default(0)
  version     Int         @default(1)

  // Staleness tracking
  isStale     Boolean     @default(false)
  reviewDate  DateTime?
  staleReason String?

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Document?   @relation("DocTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Document[]  @relation("DocTree")
  versions    DocVersion[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([parentId])
}

model DocVersion {
  id         String   @id @default(cuid())
  documentId String
  version    Int
  title      String
  content    String   @db.Text
  changeNote String?

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

// ─────────────────────────────────────────────
// WORKSPACES & RBAC (Phase 8 / v2)
// ─────────────────────────────────────────────

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  avatarUrl   String?
  ownerId     String

  members     WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  projects      Project[]
  projectGroups ProjectGroup[]
  auditLogs     AuditLog[]
  policyPackSettings PolicyPackSetting[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceInvitation {
  id          String           @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole    @default(member)
  tokenHash   String           @unique @map("token") // SHA-256 of the one-time invite token
  status      InvitationStatus @default(pending)
  expiresAt   DateTime

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([workspaceId])
  @@index([email])
}

// ─────────────────────────────────────────────
// AUDIT LOGGING (Phase 8 / v2)
// ─────────────────────────────────────────────

model AuditLog {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  projectId   String?
  action      String    // e.g. "project.created", "analysis.triggered", "env.updated", "member.invited"
  entityType  String    // e.g. "project", "analysis", "env", "document", "member"
  entityId    String
  metadata    Json?     // payload or before/after diff

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime  @default(now())

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// PROJECT GROUPS & FULLSTACK SYSTEMS
// ─────────────────────────────────────────────

model ProjectGroup {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  name        String
  slug        String
  description String?

  latestScore Int?     // 0-100 composite system score
  systemData  Json?    // Summary statistics and route count metrics

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  members     ProjectGroupMember[]
  analyses    SystemAnalysis[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
  @@index([workspaceId])
}

model ProjectGroupMember {
  id        String           @id @default(cuid())
  groupId   String
  projectId String
  role      ProjectGroupRole @default(service)
  apiPrefix String?          // e.g. "/api" or "/v1"

  group     ProjectGroup     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([groupId, projectId])
  @@index([groupId])
  @@index([projectId])
}

model SystemAnalysis {
  id             String               @id @default(cuid())
  groupId        String
  status         SystemAnalysisStatus @default(queued)

  overallScore   Int?
  contractScore  Int?
  envScore       Int?
  frontendScore  Int?
  backendScore   Int?

  contractMatrix Json?                // Matched, broken, and orphaned API routes
  envDrift       Json?                // CORS, base URLs, and ports
  systemGraph    Json?                // Composite React Flow nodes and cross-repo bridge edges
  findings       Json?                // Cross-service system findings

  durationMs     Int?
  errorMessage   String?

  group          ProjectGroup         @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([groupId])
}

// ─────────────────────────────────────────────
// WAITLIST & MARKETING LEADS
// ─────────────────────────────────────────────

model WaitlistLead {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  @default("pricing_pro")
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────
// ADMIN EMAILS & BROADCASTS
// ─────────────────────────────────────────────

model AdminEmail {
  id              String   @id @default(cuid())
  senderId        String
  subject         String
  body            String   @db.Text
  template        String?  @default("custom")
  targetType      String   // "all" | "selected" | "individual"
  recipientCount  Int
  recipientEmails Json     // string[]
  status          String   @default("sent") // "sent" | "delivered" | "simulated"
  createdAt       DateTime @default(now())

  @@index([senderId])
  @@index([createdAt(sort: Desc)])
}



// ─────────────────────────────────────────────
// ROADMAP: PR CHECKS, POLICY, NOTIFICATIONS, SHARING & PATCH REVIEW
// ─────────────────────────────────────────────

model GitHubWebhookDelivery {
  id             String                 @id // GitHub X-GitHub-Delivery idempotency key
  event          String
  action         String?
  repository     String?
  status         WebhookDeliveryStatus  @default(received)
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([status, createdAt])
}

model PullRequestAnalysis {
  id           String                    @id @default(cuid())
  projectId    String
  number       Int
  title        String
  baseBranch   String
  headBranch   String
  baseSha      String
  headSha      String
  status       PullRequestAnalysisStatus @default(queued)
  analysisId   String?                   @unique
  checkRunId   String?
  checkUrl     String?
  checkError   String?
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation("PullRequestAnalysisToAnalysis", fields: [analysisId], references: [id], onDelete: SetNull)

  @@unique([projectId, number, headSha])
  @@index([projectId, number, createdAt(sort: Desc)])
  @@index([status, createdAt])
}

model PolicyPackSetting {
  id          String   @id @default(cuid())
  workspaceId String?
  projectId   String?
  packKey     String
  version     String   @default("1.0.0")
  enabled     Boolean  @default(true)
  overrides   Json     @default("{}")
  updatedById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, packKey])
  @@unique([projectId, packKey])
  @@index([workspaceId])
  @@index([projectId])
}

model FindingTriage {
  id           String             @id @default(cuid())
  projectId    String
  fingerprint  String
  ruleId       String
  title        String
  status       FindingTriageStatus @default(open)
  assigneeId   String?
  note         String?            @db.Text
  updatedById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  events  FindingTriageEvent[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status, updatedAt(sort: Desc)])
}

model FindingTriageEvent {
  id        String             @id @default(cuid())
  triageId  String
  actorId   String
  fromStatus FindingTriageStatus?
  toStatus   FindingTriageStatus
  note       String?            @db.Text
  createdAt  DateTime           @default(now())

  triage FindingTriage @relation(fields: [triageId], references: [id], onDelete: Cascade)
  actor  User          @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([triageId, createdAt])
  @@index([actorId, createdAt])
}

model ScanSchedule {
  id          String      @id @default(cuid())
  projectId   String      @unique
  cadence     ScanCadence @default(weekly)
  enabled     Boolean     @default(true)
  branch      String
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastError   String?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([enabled, nextRunAt])
}

model NotificationPreference {
  userId                    String   @id
  enabled                   Boolean  @default(true)
  minimumSeverity           String   @default("critical")
  scoreRegressionThreshold  Int      @default(10)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  projectId  String?
  analysisId String?
  kind       NotificationKind
  dedupeKey  String           @unique
  title      String
  body       String           @db.Text
  data       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model ReportShareLink {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  analysisId  String
  projectId   String
  createdById String
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([expiresAt, revokedAt])
}

model PatchSuggestion {
  id                 String               @id @default(cuid())
  projectId          String
  analysisId         String
  userId             String
  findingFingerprint String
  provider           String
  model              String
  summary             String              @db.Text
  diff                String              @db.Text
  validation          Json?
  status              PatchSuggestionStatus @default(proposed)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([analysisId, findingFingerprint])
}
