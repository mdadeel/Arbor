# Arbor — Environment Configuration Example
# Copy to .env before running locally: cp .env.example .env
# Authoritative runtime schema: src/lib/env.ts (validated at import time with Zod).
# Note: AI provider keys (OpenAI / Anthropic) are bring-your-own-key per user,
# stored encrypted in PostgreSQL — do NOT add OPENAI_API_KEY or ANTHROPIC_API_KEY here.

# ─────────────────────────────────────────────────────────────────────────────
# 1. Required (no default in src/lib/env.ts — app, worker, and build fail without these)
# ─────────────────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://arbor:arbor@localhost:5432/arbor"
REDIS_URL="redis://localhost:6379"
NEXTAUTH_SECRET="replace-me-with-openssl-rand-base64-32-placeholder"

# Encrypts stored user AI provider keys (and GitHub tokens) in the database;
# rotating ENCRYPTION_SECRET invalidates all previously stored keys.
ENCRYPTION_SECRET="replace-me-with-separate-32-byte-encryption-placeholder"

# ─────────────────────────────────────────────────────────────────────────────
# 2. Optional with defaults in src/lib/env.ts
# ─────────────────────────────────────────────────────────────────────────────

# Repository cloning & static analysis limits
CLONE_BASE_DIR="/tmp/arbor-clones"
CLONE_TIMEOUT="60"
MAX_REPO_SIZE_MB="500"
MAX_FILES="5000"
MAX_FILE_SIZE_KB="100"
MAX_PARSE_FILES="2500"
ANALYSIS_TIMEOUT_MS="300000"

# Application URL & serverless worker cron guard
# (src/lib/env.ts defaults APP_URL to https://arborgit.vercel.app; override for local dev)
APP_URL="http://localhost:3000"
CRON_SECRET="replace-me-with-cron-secret-placeholder"

# GitHub OAuth & webhook verification (leave empty if not using GitHub OAuth / webhooks locally)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_WEBHOOK_SECRET=""

# Merchant-of-record workspace billing via Lemon Squeezy (optional; leave empty when self-hosting without paid plans)
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_TEAMS_VARIANT_ID=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# Admin allowlists (comma-, semicolon-, or whitespace-separated)
ADMIN_EMAILS=""
ADMIN_GITHUB_USERNAMES=""

# ADMIN_USERNAME and ADMIN_PASSWORD enable credential login when both are set;
# they must stay empty in production.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# 3. Read outside src/lib/env.ts (direct process.env / NextAuth runtime / test fixtures)
# ─────────────────────────────────────────────────────────────────────────────

# Used by NextAuth.js at runtime for canonical callback URLs
NEXTAUTH_URL="http://localhost:3000"

# Optional transactional email delivery in src/server/services/admin.ts (Resend API)
RESEND_API_KEY=""
EMAIL_FROM="Arbor Platform <noreply@example.com>"

# Optional Playwright PDF export overrides (scripts/export-report.ts)
REPORT_BASE_URL="http://localhost:3000"
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=""
PLAYWRIGHT_CHROMIUM_ARGS=""

# Referenced in test fixtures surfaced by process.env scan (not read by server runtime)
APP_TOKEN=""
SECRET_KEY=""
NEXT_PUBLIC_API_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# 4. Self-Hosted Docker Compose Profiles & Overrides (docker-compose.yml)
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated Compose profiles enabled on `docker compose up -d --build`:
#   "postgres,redis" -> starts bundled PostgreSQL 16 + Redis 7 alongside migrate/app/worker
#   "postgres"       -> bundled PostgreSQL + external managed Redis (set DOCKER_REDIS_URL)
#   "redis"          -> external managed PostgreSQL (set DOCKER_DATABASE_URL) + bundled Redis
#   ""               -> external managed PostgreSQL + external managed Redis (migrate/app/worker only)
COMPOSE_PROFILES="postgres,redis"

# Container-network connection URLs (default to the bundled `postgres` and `redis` services)
DOCKER_DATABASE_URL="postgresql://arbor:arbor@postgres:5432/arbor"
DOCKER_REDIS_URL="redis://redis:6379"

# Optional host port & bundled PostgreSQL credential overrides
APP_PORT="3000"
POSTGRES_PORT="5432"
REDIS_PORT="6379"
POSTGRES_USER="arbor"
POSTGRES_PASSWORD="arbor"
POSTGRES_DB="arbor"

# Set to "true" only on single-container PaaS hosts without the `migrate` init container
ARBOR_RUN_MIGRATIONS="false"

